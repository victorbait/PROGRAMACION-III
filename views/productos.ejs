<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Productos de Barbería | Belleza Móvil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #0f172a, #111827);
      color: #f9fafb;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar {
      background-color: #111827 !important;
    }

    .navbar-brand, .nav-link {
      color: #e5e7eb !important;
    }

    .productos-hero {
      padding: 3rem 1rem;
      background: radial-gradient(circle at top, #1f2937 0, #020617 60%);
      text-align: center;
    }

    .productos-hero h1 {
      font-size: 2.3rem;
      margin-bottom: 0.5rem;
    }

    .productos-hero p {
      color: #e5e7eb;
      margin-bottom: 0;
    }

    .card-producto {
      background: #020617;
      border: 1px solid #374151;
      border-radius: 1rem;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .card-producto:hover {
      transform: translateY(-3px);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
      border-color: #f97316;
    }

    .card-producto h2 {
      color: #f9fafb;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
      letter-spacing: 0.02em;
    }

    .badge-codigo {
      font-family: monospace;
      background-color: #111827;
      border: 1px solid #4b5563;
    }

    /* Mejor contraste para textos secundarios (Bootstrap usa grises muy bajos) */
    .text-muted {
      color: #d1d5db !important;
    }

    .descripcion-producto {
      color: #e5e7eb;
      line-height: 1.45;
    }

    .precio {
      font-weight: bold;
      color: #fbbf24;
      font-size: 1.1rem;
    }

    .seccion-formulario {
      background: #020617;
      border-radius: 1rem;
      border: 1px solid #374151;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
    }

    .btn-primary {
      background: linear-gradient(135deg, #f97316, #ea580c);
      border: none;
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #fb923c, #f97316);
    }

    footer {
      margin-top: auto;
      color: #cbd5e1;
      text-align: center;
      padding: 1rem 0;
      font-size: 0.85rem;
      border-top: 1px solid #1f2933;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Belleza Móvil</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
              aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link active" aria-current="page" href="/productos">Productos</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <header class="productos-hero">
    <h1>Insumos y Productos de Barbería</h1>
    <p>Herramientas y productos premium que usamos en tus servicios a domicilio.</p>
  </header>

  <main class="container my-4">
    <% if (mensajeExito) { %>
      <div class="alert alert-success" role="alert">
        <%= mensajeExito %>
      </div>
    <% } %>
    <% if (mensajeError) { %>
      <div class="alert alert-danger" role="alert">
        <%= mensajeError %>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-8">
        <section aria-label="Listado de productos de barbería">
          <div class="row g-3">
            <% if (productos && productos.length > 0) { %>
              <% productos.forEach(function(prod) { %>
                <div class="col-md-6">
                  <article class="card card-producto h-100 p-3">
                    <header class="d-flex justify-content-between align-items-start mb-2">
                      <h2 class="h5 mb-0"><%= prod.nombre %></h2>
                      <span class="badge rounded-pill badge-codigo">
                        <small>Código: <%= prod.codigo %></small>
                      </span>
                    </header>
                    <p class="mb-2 descripcion-producto"><%= prod.descripcion %></p>
                    <p class="precio mb-0">$ <%= Number(prod.precio).toFixed(2) %></p>
                  </article>
                </div>
              <% }); %>
            <% } else { %>
              <div class="col-12">
                <p class="text-muted">Aún no hay productos cargados.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>

      <div class="col-lg-4">
        <% if (esAdmin) { %>
          <section class="p-3 seccion-formulario" aria-label="Formulario para crear productos">
            <h2 class="h5 mb-3">Agregar nuevo producto</h2>
            <form method="POST" action="/productos">
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre del producto</label>
                <input type="text" class="form-control" id="nombre" name="nombre" required>
              </div>
              <div class="mb-3">
                <label for="codigo" class="form-label">Código</label>
                <input type="text" class="form-control" id="codigo" name="codigo" required>
                <div class="form-text text-muted">Debe ser único, por ejemplo: WAHL-PRO, POMADE-MATTE.</div>
              </div>
              <div class="mb-3">
                <label for="precio" class="form-label">Precio</label>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <input type="number" class="form-control" id="precio" name="precio" required min="0.01" step="0.01">
                </div>
              </div>
              <div class="mb-3">
                <label for="descripcion" class="form-label">Descripción</label>
                <textarea class="form-control" id="descripcion" name="descripcion" rows="3" required
                          placeholder="Ej: Máquina Wahl profesional para degradados perfectos."></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100">Guardar producto</button>
            </form>
          </section>
        <% } else { %>
          <section class="p-3 seccion-formulario" aria-label="Información para usuarios">
            <h2 class="h5 mb-2">Solo admin puede crear productos</h2>
            <p class="mb-0 text-muted">
              Puedes ver los productos que utilizamos en tus servicios. Para agregar o actualizar insumos,
              inicia sesión como administrador.
            </p>
          </section>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <p>© 2025 Belleza Móvil · Productos profesionales para barbería a domicilio.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

