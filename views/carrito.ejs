<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tu Carrito | Belleza Móvil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: radial-gradient(circle at top, #1f2937 0, #020617 60%);
      color: #f9fafb;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar {
      background-color: #111827 !important;
    }

    .navbar-brand, .nav-link {
      color: #e5e7eb !important;
    }

    .carrito-hero {
      padding: 2.5rem 1rem 1.5rem;
      text-align: center;
    }

    .carrito-hero h1 {
      font-size: 2.1rem;
      margin-bottom: 0.25rem;
    }

    .carrito-hero p {
      color: #d1d5db;
      margin-bottom: 0;
    }

    .card-item {
      background: #020617;
      border-radius: 1rem;
      border: 1px solid #374151;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
    }

    .precio-item {
      font-weight: bold;
      color: #fbbf24;
    }

    .total {
      font-size: 1.4rem;
      font-weight: bold;
      color: #facc15;
    }

    .btn-outline-light {
      border-color: #f9fafb;
      color: #f9fafb;
    }

    .btn-outline-light:hover {
      background-color: #f9fafb;
      color: #111827;
    }

    footer {
      margin-top: auto;
      color: #cbd5e1;
      text-align: center;
      padding: 1rem 0;
      font-size: 0.85rem;
      border-top: 1px solid #1f2933;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Belleza Móvil</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
              aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/productos">Productos</a></li>
          <li class="nav-item"><a class="nav-link active" aria-current="page" href="/carrito">Carrito</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <header class="carrito-hero">
    <h1>Tu Carrito de Barbería</h1>
    <p>Revisa los productos que usaremos en tus próximos servicios.</p>
  </header>

  <main class="container mb-4">
    <div class="row g-4">
      <div class="col-lg-8">
        <% if (items && items.length > 0) { %>
          <% items.forEach(function(item) { %>
            <article class="card card-item mb-3">
              <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start">
                <div>
                  <h2 class="h5 mb-1"><%= item.producto?.nombre %></h2>
                  <p class="mb-1 text-muted"><%= item.producto?.descripcion %></p>
                  <small class="text-muted">Cantidad: <strong><%= item.cantidad %></strong></small>
                </div>
                <div class="text-md-end mt-2 mt-md-0">
                  <p class="mb-1 precio-item">
                    $ <%= (Number(item.producto?.precio || 0) * item.cantidad).toFixed(2) %>
                  </p>
                  <small class="text-muted">
                    $ <%= Number(item.producto?.precio || 0).toFixed(2) %> c/u
                  </small>
                </div>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <div class="alert alert-secondary text-dark" role="alert">
            Tu carrito está vacío. Ve a la sección de <a href="/productos" class="alert-link">Productos</a> para agregar insumos.
          </div>
        <% } %>
      </div>

      <div class="col-lg-4">
        <div class="card card-item p-3">
          <h2 class="h5 mb-3">Resumen</h2>
          <p class="mb-1">Total estimado:</p>
          <p class="total mb-3">$ <%= total.toFixed(2) %></p>

          <button id="btnVaciarCarrito" class="btn btn-outline-light w-100 mb-2"
                  <% if (!items || items.length === 0) { %>disabled<% } %>>
            Vaciar carrito
          </button>
          <button class="btn btn-primary w-100" disabled>
            Confirmar servicio (próximamente)
          </button>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <p>© 2025 Belleza Móvil · Carrito de productos de barbería a domicilio.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const btnVaciar = document.getElementById('btnVaciarCarrito');
    if (btnVaciar) {
      btnVaciar.addEventListener('click', async () => {
        if (!confirm('¿Seguro que deseas vaciar tu carrito?')) return;
        try {
          const response = await fetch('/carrito/vaciar', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            window.location.reload();
          } else {
            alert('No se pudo vaciar el carrito.');
          }
        } catch (error) {
          alert('Error de conexión con el servidor.');
        }
      });
    }
  </script>
</body>
</html>

